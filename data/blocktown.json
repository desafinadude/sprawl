  "goals": [
    {"id":"quiet","name":"Quiet Streets","text":"+1 per Housing space with no road.","count":{"what":"spaces","zone":"home","road":false},"points":1},
    {"id":"main","name":"Main Street","text":"+1 per Market space with a road.","count":{"what":"spaces","zone":"shop","road":true},"points":1},
    {"id":"freight","name":"Freight Lines","text":"+1 per Industry space with a road.","count":{"what":"spaces","zone":"work","road":true},"points":1},
    {"id":"belt","name":"Green Belt","text":"+1 per Park space next to an empty space.","count":{"what":"spaces","zone":"park","touchingEmpty":true},"points":1},
    {"id":"corner","name":"Corner Shops","text":"+1 per Market space touching 2 or more Housing spaces.","count":{"what":"spaces","zone":"shop","touching":{"zone":"home","min":2}},"points":1},
    {"id":"air","name":"Clean Air","text":"10, minus 1 for each pair of touching Housing and Industry spaces.","count":{"what":"pairs","a":"home","b":"work"},"points":-1,"base":10},
    {"id":"estates","name":"Industrial Estates","text":"+3 per Industry group of 3 or more spaces.","count":{"what":"groups","zone":"work","minSize":3},"points":3},
    {"id":"pocket","name":"Pocket Parks","text":"+1 per Park group of exactly 1 space.","count":{"what":"groups","zone":"park","minSize":1,"maxSize":1},"points":1},
    {"id":"compact","name":"Compact City","text":"12, minus 1 per empty space inside your city's bounding box (min 0).","count":{"what":"emptyInBounds"},"points":-1,"base":12,"min":0},
    {"id":"mixed","name":"Mixed Use","text":"+1 per 2×2 area containing all four zone types and spaces from at least 2 different cards.","count":{"what":"squares","zones":["home","shop","work","park"],"minCards":2},"points":1},
    {"id":"boulevard","name":"Boulevard","text":"+1 per 2 road spaces in your largest road network.","count":{"what":"roadLength","rank":1},"points":1,"per":2},
    {"id":"rows","name":"Full Spectrum","text":"+1 per 2 rows or columns containing all four zone types.","count":{"what":"lines","zones":["home","shop","work","park"],"direction":"both"},"points":1,"per":2},
    {"id":"twin","name":"Twin Towns","text":"+2 per space in your second-largest Housing group.","count":{"what":"groupSize","zone":"home","rank":2},"points":2}
  ],
